PORT=5000
NODE_ENV=development

# Firebase Admin Configuration (Optional if using local seed fallback)
# Set either path to serviceAccountKey.json or FIREBASE_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=../serviceAccountKey.json
FIREBASE_PROJECT_ID=pgi-saathi

# Admin API Key for Standalone/Mock Mode (non-production only)
ADMIN_API_KEY=dev-admin-key

# Content Governance & Rate Limiting
STALE_THRESHOLD_DAYS=90
FEEDBACK_RATE_LIMIT_MAX=15
