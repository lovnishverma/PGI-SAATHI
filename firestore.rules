rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if caller is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public directory entries: ONLY published records are publicly readable
    // Prevents accidental leakage of draft, retracted, or unverified hospital guidance
    match /departments/{deptId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /buildings/{buildingId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // System configuration (OPD timings, emergency guidelines, test counters)
    // Only published configuration documents are readable by public clients
    match /system_config/{configId} {
      allow read: if resource.data.status == 'published' || !('status' in resource.data);
      allow write: if isAdmin();
    }

    // User Feedback: Anonymous write-only with strict validation
    // Protects patient privacy (disallows unauthorized reads and oversized payloads)
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['category', 'message', 'created_at'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5
                    && request.resource.data.message.size() <= 1200
                    && (!request.resource.data.keys().hasAny(['cr_number', 'aadhaar', 'medical_report', 'prescription', 'phone', 'patient_name']));
      allow read, update, delete: if isAdmin();
    }

    // Admin profiles and audit logs
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
