# PGI Saathi - Firebase Environment Variables
# Obtain these credentials from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Note: PGI Saathi automatically falls back to local seed data if these keys are omitted.

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=pgi-saathi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pgi-saathi
VITE_FIREBASE_STORAGE_BUCKET=pgi-saathi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
