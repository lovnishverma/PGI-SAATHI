# ==============================================================================
# PGI Saathi - Master Environment Configuration Template
# ==============================================================================
# For local testing, copy to .env or pass through environment variables.
# PGI Saathi functions 100% offline using bundled authoritative data
# when these credentials are not provided.
# ==============================================================================

# Frontend Firebase Web SDK (Optional - triggers real-time Firestore sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deployment Base Path (e.g. /PGI-SAATHI/ on GitHub Pages, / on custom domain)
VITE_BASE_PATH=/

# Backend API Configuration (Optional)
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,https://lovnishverma.github.io
